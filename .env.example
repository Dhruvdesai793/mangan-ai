# MANGAN-AI backend prototype configuration
MANGAN_ENV=development
MANGAN_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MANGAN_API_KEY=
MANGAN_RATE_LIMIT_REQUESTS=120
MANGAN_RATE_LIMIT_WINDOW_SECONDS=60
MANGAN_MAX_REQUEST_BODY_BYTES=1048576
MANGAN_HOST=0.0.0.0
MANGAN_PORT=8000
DATABASE_URL=postgresql+psycopg://moil:change-me@localhost:5433/moil_intelligence
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
MANGAN_DATABASE_REQUIRED=false
MANGAN_AUTO_SEED=true
GEE_ENABLED=false
GEE_PROJECT_ID=
GEE_AUTH_METHOD=oauth
GEE_ALLOW_DEMO_FEATURES=true
GEE_START_DATE=2025-01-01
GEE_END_DATE=2025-12-31
GEE_CLOUD_PERCENT=25
FRONTEND_API_URL=http://api:8000
APP_UID=1000
APP_GID=1000
GEE_CREDENTIALS_DIR=/home/your-user/.config/earthengine
