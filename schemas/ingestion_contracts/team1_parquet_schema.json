{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team1FeatureDataset",
  "description": "Contract for the Parquet dataset Team 1 (spatial data preparation) must deliver. Feature engineering downstream never runs until a file validates against this.",
  "type": "object",
  "properties": {
    "sample_id":        {"type": "string"},
    "latitude":          {"type": "number", "minimum": -90, "maximum": 90},
    "longitude":         {"type": "number", "minimum": -180, "maximum": 180},
    "sentinel2_b2":      {"type": "number"},
    "sentinel2_b3":      {"type": "number"},
    "sentinel2_b4":      {"type": "number"},
    "sentinel2_b8":      {"type": "number"},
    "sentinel2_b11":     {"type": "number"},
    "sentinel2_b12":     {"type": "number"},
    "ndvi":              {"type": "number", "minimum": -1, "maximum": 1},
    "ndmi":              {"type": "number", "minimum": -1, "maximum": 1},
    "elevation_m":       {"type": "number"},
    "slope_deg":         {"type": "number", "minimum": 0, "maximum": 90},
    "curvature":         {"type": "number"},
    "geology_class":     {"type": "string"},
    "label":             {"type": "integer", "enum": [0, 1], "description": "1 = known/likely manganese occurrence, 0 = background"},
    "grid_tile_id":      {"type": "string", "description": "spatial block id used later for spatial CV grouping"},
    "acquisition_date":  {"type": "string", "format": "date"}
  },
  "required": ["sample_id","latitude","longitude","sentinel2_b2","sentinel2_b3","sentinel2_b4",
               "sentinel2_b8","sentinel2_b11","sentinel2_b12","ndvi","ndmi","elevation_m",
               "slope_deg","curvature","geology_class","label","grid_tile_id"]
}
